# AgentSettle (HSP, x402) -- copy to .env and fill. NEVER commit .env.
# Keys from the brief (03-hsk-horizon.md §6.B), plus a few optional ones marked "optional".

# --- HashKey Chain RPCs ---
HASHKEY_RPC_URL=https://mainnet.hsk.xyz
HASHKEY_TESTNET_RPC_URL=https://testnet.hsk.xyz
# --- Ethereum Sepolia: where HashKey asks hackathon teams to test USDC payments (Circle's USDC, faucet.circle.com) ---
ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- x402 facilitator (Ultravioleta). Point at http://127.0.0.1:8403 to use the local dev facilitator. ---
FACILITATOR_URL=https://facilitator.ultravioletadao.xyz

# --- Wallets (generated with `cast wallet new`; values ONLY here) ---
# Mainnet: W3 = operator / Agent B (seller), W4 = Agent A (buyer)
OPERATOR_PRIVATE_KEY=
BUYER_PRIVATE_KEY=
# Testnet copies (HashKey testnet and Ethereum Sepolia): W5 = operator / seller, W6 = buyer (pays x402, and signs the
# HSP Agentic Payment authorization locally; the key never goes to the MCP server). The HSP web checkout (payment_url)
# is paid from a person's own wallet.
TESTNET_OPERATOR_PRIVATE_KEY=
TESTNET_BUYER_PRIVATE_KEY=

# --- HSP Agentic Payment (MCP, Streamable HTTP; no credentials: HSP holds app key and secret). `pnpm hsp:pay` runs
#     ONE payment with a person confirming each step. HSP_MCP_NETWORK=base-sepolia is the fallback chain.
HSP_MCP_URL=https://mcp-qa.hashkeymerchant.com/
HSP_MCP_NETWORK=hashkey-testnet

# --- HSP REST rail = the HashKey Merchant API (QA gateway, off the critical path). Its secrets are NOT in .env: they live in AWS SSM
#     (SecureString) under HSP_SSM_PREFIX: merchant-private-key (pnpm hsp:keygen), app-key and app-secret (merchant
#     console). See docs/hsp/REGISTRATION.md. HSP_SSM_PREFIX=off disables the SSM lookup.
HSP_MERCHANT_BASE_URL=https://merchant-qa.hashkeymerchant.com
HSP_MERCHANT_NAME=AgentSettle
HSP_SSM_PREFIX=/agentsettle-hsk/hsp

# --- AgentSettleReceipts deployments ---
RECEIPTS_ADDRESS_MAINNET=
RECEIPTS_ADDRESS_TESTNET=
RECEIPTS_ADDRESS_ETH_SEPOLIA=

# --- optional ---
# Gas signer of the local dev facilitator (src/facilitator/local.ts). Defaults to the operator key of the network.
LOCAL_FACILITATOR_PRIVATE_KEY=
# Verifies the Ethereum Sepolia deploy on Etherscan (scripts/deploy.sh ethereum-sepolia); without it, Sourcify.
ETHERSCAN_API_KEY=
# Mainnet guard: every mainnet command refuses to run unless MAINNET_OWNER_OK is "yes" (owner OK with the amount).
# Never put it in this file. scripts/deploy.sh and the app ignore it here, but a bare `forge script` reads it (forge
# loads .env itself). Set it on the command line of that one run, e.g.
#   MAINNET_OWNER_OK=yes scripts/demo.sh --network hashkey
